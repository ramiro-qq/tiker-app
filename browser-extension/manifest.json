{
  "manifest_version": 3,
  "name": "Tiker 一键剪藏",
  "version": "1.0.5",
  "description": "一键唤起 Tiker，将当前网页的链接与标题填入剪藏任务。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "一键剪藏到 Tiker",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "24": "icons/24.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
