{
  "name": "tiker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "predev": "npm run generate:icons && npm run package:extension && node scripts/copy-preview-assets.mjs",
    "prebuild": "npm run check:version && npm run check:focus-styles && npm run generate:icons && npm run package:extension && node scripts/copy-preview-assets.mjs",
    "test:github": "node --experimental-strip-types --test scripts/test-github.mjs",
    "test:extension": "node --test scripts/test-extension.mjs",
    "test:preview": "node --experimental-strip-types --test scripts/test-preview.mjs",
    "check:preview-size": "node scripts/check-preview-size.mjs",
    "postbuild": "node scripts/check-preview-size.mjs",
    "check:focus-styles": "node scripts/check-focus-styles.mjs",
    "test:sync": "node --experimental-strip-types --test scripts/test-content.mjs scripts/test-sync.mjs",
    "test:agent": "node --experimental-strip-types --test scripts/test-agent-transport.mjs scripts/test-agent-model-policy.mjs scripts/test-learning.mjs scripts/test-learning-progress.mjs scripts/test-learning-conversation.mjs",
    "test:settings-layout": "node --test scripts/test-settings-layout.mjs",
    "test:editor": "node --test scripts/test-document-editor.mjs",
    "test:reader-layout": "node --test scripts/test-reader-layout.mjs",
    "test:search": "node --experimental-strip-types --test scripts/test-search.mjs",
    "test:search-ui": "node --test scripts/test-search-dialog.mjs scripts/test-library-search.mjs",
    "test:library-order": "node --experimental-strip-types --test scripts/test-library-order.mjs",
    "test:startup": "node --test scripts/test-no-demo.mjs scripts/test-no-demo-ui.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:repository": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "@mermaid-js/tiny": "12.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code-block-lowlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "fast-formula-parser": "1.0.19",
    "lowlight": "3.3.0",
    "lucide-react": "^1.73.0",
    "marked": "18.2.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "description": "本地资料管理、网页剪藏与 AI 探知桌面应用"
}
